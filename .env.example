# Copy to .env and fill in, then run ./run.sh
#   cp .env.example .env
#
# The cluster values can be copied from ../train/.env (same namespace, same GitLab token).
# Only IMAGE differs: a new repository name next to the SFT image.
#
# NOTE: run.sh uploads this whole file into the namespace as the grpo-env Secret, and a
# k8s Secret is only base64-encoded -- anyone with namespace access can read it. Keep
# unrelated credentials out of it, including in comments.

# ---------------------------------------------------------------------------
# NRP cluster access (used by ./run.sh)
# ---------------------------------------------------------------------------
K8S_NAMESPACE=YOUR_NAMESPACE
IMAGE=gitlab-registry.nrp-nautilus.io/your-group/your-project/context-comp-grpo:latest
# GitLab token with read_registry + write_registry (the value, starting with glpat-).
NRP_REGISTRY_TOKEN=
# Empty: derived from IMAGE. Set only for a deploy token (user = token name).
NRP_REGISTRY_USER=

# PVC holding the SFT checkpoint; mounted read-only at /data.
SFT_PVC_NAME=qwen-sft-data
# PVC for everything GRPO writes (checkpoints, rollouts, exports); mounted at /grpo.
# Created by ./run.sh if missing (GRPO/k8s/pvc.yaml, 150Gi).
RL_PVC_NAME=qwen-grpo-data
JOB_NAME=qwen-grpo

# ---------------------------------------------------------------------------
# Model and caches
# ---------------------------------------------------------------------------
# The full-parameter SFT checkpoint (../train/model_card_v3.md), as it sits on the SFT PVC.
POLICY_MODEL_PATH=/data/runs/qwen3-8b-sft-v3
# Or a Hugging Face repo id plus POLICY_MODEL_REVISION (a branch, tag or commit), which is
# downloaded once into HF_HOME; private repos need HF_TOKEN. The same v3 checkpoint:
#   POLICY_MODEL_PATH=Lucas-SJY/qwen3-8b-sft-bespoke
#   POLICY_MODEL_REVISION=v3
HF_TOKEN=
HF_HOME=/grpo/hf
HF_DATASETS_CACHE=/workspace/.cache/datasets

# ---------------------------------------------------------------------------
# Run
# ---------------------------------------------------------------------------
# One directory per run under OUTPUT_ROOT; a restarted pod resumes from its checkpoints.
RUN_NAME=qwen3-8b-grpo-labels-v1
OUTPUT_ROOT=/grpo/runs
# true: 3 tiny steps to prove the pipeline (writes to <RUN_NAME>-smoke).
SMOKE_TEST=false
# Task files inside the image; unset = /workspace/data/{train,validation}.jsonl. The
# grpo_try set (GRPO/src/prepare_grpo_try.py) has only 6 training tasks, so it also
# needs TRAIN_BATCH_SIZE <= 6; see the README.
# TRAIN_FILE=/workspace/data/grpo_try/train.jsonl
# VAL_FILE=/workspace/data/grpo_try/validation.jsonl
# The Bespoke-Stratos questions outside the SFT set with one checkable answer, 4,776 / 526
# (GRPO/src/prepare_rest_grpo.py):
# TRAIN_FILE=/workspace/data/rest_grpo/train.jsonl
# VAL_FILE=/workspace/data/rest_grpo/validation.jsonl

# GRPO sampling: TRAIN_BATCH_SIZE questions per step, GROUP_SIZE answers per question.
TRAIN_BATCH_SIZE=8
GROUP_SIZE=8
MAX_PROMPT_LENGTH=2048
MAX_RESPONSE_LENGTH=8192
ROLLOUT_GPU_MEM_UTIL=0.7
# Tokens per micro-batch in the update and log-prob passes; default prompt + response +
# 2048. Under FSDP_CPU_OFFLOAD each micro-batch pays a fixed cost to stream the weights
# in and the gradients out, so 32768 (~60 GB on an 80 GB card) is much faster.
# PPO_MAX_TOKEN_LEN=32768

# Actor (a LoRA adapter trained on top of the full SFT weights). With LoRA the frozen
# base weights are kept in bf16, which is what fits the 8B run on a 48 GB card;
# ACTOR_MODEL_DTYPE=fp32 restores verl's default. LORA_RANK=0 trains all parameters
# (use ACTOR_LR=1e-6); for 8B that needs N_GPUS=4 A100s, or 1 with FSDP_CPU_OFFLOAD=true
# (see the README). Its checkpoints leave out the Adam state (~33 GB instead of ~100 GB,
# so two fit the 150Gi RL PVC); CKPT_SAVE_OPTIMIZER=true keeps it, on a larger PVC.
LORA_RANK=64
LORA_ALPHA=32
ACTOR_LR=1e-5
# Questions per optimizer step: TRAIN_BATCH_SIZE / PPO_MINI_BATCH_SIZE updates per step.
PPO_MINI_BATCH_SIZE=4
CLIP_LOW=0.2
CLIP_HIGH=0.28
# KL to the SFT policy, as a loss term. 0 disables it.
KL_BETA=0.001
# true: advantage = (r - group mean) / group std (standard GRPO). false: only subtract the
# mean (Dr. GRPO), which stops tiny reward differences inside a group from being scaled up.
NORM_ADV_BY_STD=true

# Reward = w_label * label_valid + w_correct * answer_correct (0.2 and 0.8). label_valid:
# 1 if the thought has tags and all of them are among the eight labels, else 0 (no
# reference trace is used). tag_rate and label_mix are logged but not part of the reward.
REWARD_W_LABEL=0.2
REWARD_W_CORRECT=0.8
# Format rule, not a reward term: an answer whose thought has a tag outside the eight
# labels is regenerated, up to this many extra times; one still invalid after that loses the
# label part of the reward.
MAX_LABEL_RETRIES=3
# An answer cut off at MAX_RESPONSE_LENGTH is dropped from the training batch (no reward,
# no gradient, not part of its group's mean/std) instead of scoring 0. false: score 0.
MASK_TRUNCATED=true

# Schedule. TOTAL_TRAINING_STEPS caps the run (-1 = full epochs); one epoch at 8 questions
# per step is 630 steps.
EPOCHS=1
TOTAL_TRAINING_STEPS=200
SAVE_FREQ=20
TEST_FREQ=20
VAL_BEFORE_TRAIN=true
SEED=42

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
# Same as ../train/.env: empty REPORT_TO = console only. "wandb" streams every metric
# (reward, accuracy, label shares, KL, timings) to wandb.ai, which survives a dropped
# kubectl connection or an evicted pod.
REPORT_TO=wandb
# From https://wandb.ai/authorize. Required unless WANDB_MODE=offline.
WANDB_API_KEY=
WANDB_PROJECT=context-comp-grpo
# WANDB_MODE=offline

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
RAY_OBJECT_STORE_GB=16
# GPU card: l40 (L40 / L40S, 48 GB), a6000 (RTX A6000, 48 GB) or a100 (A100-80GB). With
# GPU_PRIORITY_CLASS unset, a100 runs at priority "opportunistic": no quota needed, but
# the pod can be preempted at any time (it resumes from the last checkpoint).
# GPU_PRIORITY_CLASS= (empty) runs at normal priority within the namespace's A100 quota
# (4 since 2026-10-05) and is not preempted.
GPU_TYPE=l40
# GPU_PRIORITY_CLASS=
# Cards on the one node the pod runs on (FSDP shards the actor, one vLLM replica per card).
# Full-parameter 8B: 4 A100s, POD_CPU=16, POD_MEMORY=256Gi; or 1-2 with FSDP_CPU_OFFLOAD
# (one card: POD_CPU=14, POD_MEMORY=288Gi, OMP_NUM_THREADS=10).
N_GPUS=1
# true: FSDP2 with CPU offload. The actor's weights, gradients and Adam state stay in
# pinned host RAM, layers are copied to the GPU only while computed, and Adam steps on
# the CPU with OMP_NUM_THREADS threads per worker (Ray's default is 1). Lets
# full-parameter 8B run on 1-2 A100s, at the cost of slower steps.
# FSDP_CPU_OFFLOAD=true
# OMP_NUM_THREADS=6
# Training pod size (requests = limits). The defaults fit the 8B run; a small model such
# as Qwen3-0.6B runs with POD_CPU=4, POD_MEMORY=64Gi, RAY_OBJECT_STORE_GB=8, and is then
# much easier to schedule.
POD_CPU=8
POD_MEMORY=160Gi
# CPUs Ray may hand out; unset = the pod's CPUs. verl and vLLM need more than 4, so set 8
# when POD_CPU is lower (Ray's CPUs only gate scheduling).
# RAY_NUM_CPUS=8
NCCL_DEBUG=WARN
TOKENIZERS_PARALLELISM=false
# Do not copy PYTORCH_ALLOC_CONF=expandable_segments:True over from the SFT .env: vLLM's
# sleep mode, which lets rollout and training share the GPU, refuses to run with it.

# ---------------------------------------------------------------------------
# Local only -- used by run.sh on your machine, ignored inside the container.
# ---------------------------------------------------------------------------
BESPOKE_DIR=../train/bespoke-v2
SFT_SPLIT_DIR=../train/data_labeled_2
PYTHON_BIN=python3
