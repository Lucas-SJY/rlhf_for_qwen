.DS_Store

# Secrets live in .env files at any depth (./.env, GRPO/.env, ...); patterns
# without a slash match in every directory. Only the placeholder templates are tracked.
.env
.env.*
!.env.example

# Generated task set (rebuild with ./run.sh data)
GRPO/data/
# Questions without a checkable answer, split off by GRPO/src/prepare_rest_grpo.py
/no_answer/
# Scored model answers copied back by ./run.sh answer / fetch-answers
/answers/
# Training questions held out for manual inspection (GRPO/src/prepare_rest_grpo.py)
/manual_inspection/
# MATH-500 results fetched by evaluate/run_eval.sh
/evaluate/results/
# Rollout counts fetched by evaluate/rollout_stats.sh
/eval-results/

__pycache__/
*.py[cod]
grpo_try/