# Small GRPO example on NRP: Qwen3-0.6B, full-parameter (no LoRA), monitored in wandb.
# Copy to .env next to this file and fill in, then run ./run.sh from this directory:
#   cp .env.example .env
#
# Same layout as ../../../train/.env. The cluster values are the same as in the project
# root .env. The example uses its own Secret (grpo-example-env) and Job (qwen-grpo-example),
# so it never touches the main run's settings.
#
# NOTE: run.sh uploads this whole file into the namespace as the grpo-example-env Secret,
# and a k8s Secret is only base64-encoded -- anyone with namespace access can read it.
# Keep unrelated credentials out of it, including in comments.

# ---------------------------------------------------------------------------
# NRP cluster access (used by ./run.sh)
# ---------------------------------------------------------------------------
K8S_NAMESPACE=YOUR_NAMESPACE
# The GRPO training image; the same image as the main run (../../.env IMAGE).
IMAGE=gitlab-registry.nrp-nautilus.io/your-group/your-project/context-comp-grpo:latest
# GitLab token with read_registry + write_registry (the value, starting with glpat-).
NRP_REGISTRY_TOKEN=
# Empty: derived from IMAGE. Set only for a deploy token (user = token name).
NRP_REGISTRY_USER=

# PVC for outputs and the HF cache, mounted at /grpo. Shared with the main run; created by
# ./run.sh if missing. ReadWriteOnce: do not run this Job while the main GRPO Job runs.
RL_PVC_NAME=qwen-grpo-data
JOB_NAME=qwen-grpo-example

# ---------------------------------------------------------------------------
# Model and caches
# ---------------------------------------------------------------------------
# Pulled from the Hugging Face Hub on first use into HF_HOME (on the PVC). Qwen3-0.6B is
# the smallest Qwen3; it shares the tokenizer and chat template with qwen3-8b-sft-v3.
POLICY_MODEL_PATH=Qwen/Qwen3-0.6B
HF_TOKEN=
HF_HOME=/grpo/hf
HF_DATASETS_CACHE=/workspace/.cache/datasets

# ---------------------------------------------------------------------------
# Run
# ---------------------------------------------------------------------------
RUN_NAME=qwen3-0.6b-grpo-example
OUTPUT_ROOT=/grpo/runs
# true: 3 tiny steps to prove the pipeline (writes to <RUN_NAME>-smoke).
SMOKE_TEST=false

# Full-parameter training: no LoRA adapter, a separate frozen reference model, and a
# full-fine-tune learning rate.
LORA_RANK=0
ACTOR_LR=1e-6

TRAIN_BATCH_SIZE=8
GROUP_SIZE=8
PPO_MINI_BATCH_SIZE=4
MAX_RESPONSE_LENGTH=8192
ROLLOUT_GPU_MEM_UTIL=0.6

# 50 steps = 400 questions. Validation (102 held-out questions) at step 0, every
# TEST_FREQ steps and at the end.
TOTAL_TRAINING_STEPS=50
TEST_FREQ=10
SAVE_FREQ=25
VAL_BEFORE_TRAIN=true
SEED=42

# Reward = w_tag * tag_rate + w_align * label_alignment + w_correct * answer_correct.
# Qwen3-0.6B was never taught the [label] format, so expect R to be mostly 0 or 0.4.
REWARD_W_TAG=0.3
REWARD_W_ALIGN=0.3
REWARD_W_CORRECT=0.4

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
# Same as ../../../train/.env: empty REPORT_TO = console only. "wandb" streams every
# metric to wandb.ai, which survives a dropped kubectl connection or an evicted pod.
REPORT_TO=wandb
# From https://wandb.ai/authorize. Required unless WANDB_MODE=offline.
WANDB_API_KEY=
WANDB_PROJECT=context-comp-grpo
# WANDB_MODE=offline

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
RAY_OBJECT_STORE_GB=8
NCCL_DEBUG=WARN
TOKENIZERS_PARALLELISM=false

# ---------------------------------------------------------------------------
# Local only -- used by run.sh on your machine, ignored inside the container.
# ---------------------------------------------------------------------------
BESPOKE_DIR=../../../train/bespoke-v2
SFT_SPLIT_DIR=../../../train/data_labeled_2
PYTHON_BIN=python3
